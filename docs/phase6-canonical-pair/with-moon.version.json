      "endings": [
        {
          "id": "end.give",
          "text": "As you hand the letter back, Nia's eyes light up with relief. \"Thank you, I really needed this. You have no idea how much it means to me!\"",
          "title": "You returned the letter"
        },
        {
          "id": "end.keep",
          "text": "Nia's expression falters as you tuck the letter away. \"I see. I guess I can't change your mind?\" Her voice is tinged with disappointment as she turns away, leaving you alone with your choice.",
          "title": "You kept the letter"
        },
        {
          "id": "end.leave",
          "text": "You step back from the counter, uncertainty weighing on you. Nia’s gaze follows you, a mixture of hope and confusion in her eyes. You close your eyes, promising yourself to revisit this in the morning.",
          "title": "You walked away undecided"
        }
      ],
      "dialogue": [
        {
          "id": "core.inspect_text",
          "text": "The envelope is unmarked, its contents unknown. There’s a sense of importance about it, as if it carries weight beyond its physical form.",
          "speaker_id": "narrator"
        },
        {
          "id": "core.context_text",
          "text": "I left it behind in a rush. It contains something I need to send today, something important.",
          "speaker_id": "nia"
        },
        {
          "id": "core.promise_text",
          "text": "I promise to hold onto it. You can trust me with it.",
          "speaker_id": "player"
        }
      ],
