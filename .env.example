# FirstPlayable environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored. No value in this file is ever a real credential.

# --- Supabase: server runtime only -----------------------------------------
# The browser never connects to Supabase in this architecture. There is no
# NEXT_PUBLIC_ Supabase variable, and creating one would be a security defect.
SUPABASE_URL=
# Server secret key (`sb_secret_...`). Bypasses row-level security, so every
# repository in src/server/db/ still scopes its queries by owner session id.
SUPABASE_SECRET_KEY=

# --- Supabase: CLI and migration tooling only ------------------------------
# Used by `supabase link` / `supabase db push` from a developer machine.
# Application code must never read this, and it is never uploaded to Vercel.
SUPABASE_ACCESS_TOKEN=

# --- OpenAI: server runtime only -------------------------------------------
OPENAI_API_KEY=
# Pinned snapshot. A different value is a configuration error, not a fallback.
OPENAI_CHAT_MODEL=gpt-4o-mini-2024-07-18

# --- Application budget caps (optional; server only) -----------------------
# Each may only lower the specification default, never raise it.
# MODEL_DAILY_CALL_CAP=40
# MODEL_LEASE_SECONDS=120
# PROJECTS_PER_SESSION_PER_DAY=5

# --- Qloo: not used in phase 2 ---------------------------------------------
# Phase 3 introduces the Qloo adapter. No phase 2 code path reads these.
QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
