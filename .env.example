# FirstPlayable environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored. No value in this file is ever a real credential.

# --- Supabase: server runtime only -----------------------------------------
# The browser never connects to Supabase in this architecture. There is no
# NEXT_PUBLIC_ Supabase variable, and creating one would be a security defect.
SUPABASE_URL=
# Server secret key (`sb_secret_...`). Bypasses row-level security, so every
# repository in src/server/db/ still scopes its queries by owner session id.
SUPABASE_SECRET_KEY=

# --- Supabase: CLI and migration tooling only ------------------------------
# Used by `supabase link` / `supabase db push` from a developer machine.
# Application code must never read this, and it is never uploaded to Vercel.
SUPABASE_ACCESS_TOKEN=

# --- OpenAI: server runtime only -------------------------------------------
OPENAI_API_KEY=
# Pinned snapshot. A different value is a configuration error, not a fallback.
OPENAI_CHAT_MODEL=gpt-4o-mini-2024-07-18

# --- Application budget caps (optional; server only) -----------------------
# Each may only lower the compiled-in default, never raise it.
#
# MODEL_COST_CAP_MICROS is the hard CUMULATIVE OpenAI spend cap, in
# micro-dollars, measured against the estimate computed from the usage the
# provider reports. 600000 is $0.60. It does not reset: once it is reached,
# this application stops calling the provider. It replaced an earlier
# 40-calls-per-UTC-day cap, which refused real work for a few cents of spend.
# MODEL_COST_CAP_MICROS=600000
# MODEL_LEASE_SECONDS=120
# PROJECTS_PER_SESSION_PER_DAY=5

# --- Qloo: server runtime only ---------------------------------------------
# Read by the three-operation adapter in src/server/qloo/. The key travels in
# the X-Api-Key header of exactly three frozen request shapes. The browser
# never calls Qloo, and no browser-exposed variant of this name exists.
QLOO_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# --- Qloo safety policy (optional; server only) ----------------------------
# Conservative local decisions, not figures read from the API's documentation.
# Each may only tighten the default: a lower allowance, a longer launch gap,
# or fewer concurrent leases.
# QLOO_MONTHLY_CALL_ALLOWANCE=10000
# QLOO_JUDGING_RESERVE_CALLS=500
# QLOO_LAUNCH_SPACING_MS=250
# QLOO_MAX_ACTIVE_LEASES=2
# QLOO_LAUNCH_LEASE_SECONDS=40
